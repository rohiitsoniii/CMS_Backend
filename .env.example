# 🚀 HEADLESS CMS - ENVIRONMENT VARIABLES

# ============================
# SERVER CONFIGURATION
# ============================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5174

# ============================
# DATABASE
# ============================
MONGODB_URI=mongodb://localhost:27017/headless-cms
# App cache reads REDIS_HOST/PORT; background workers fall back to REDIS_URL.
# Set all three so every consumer connects.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ============================
# JWT & SECURITY
# ============================
# All three secrets are REQUIRED (min 32 chars; production refuses placeholders).
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
# Used by config for API-key handling. Distinct from ENCRYPTION_KEY below.
API_KEY_SECRET=your-api-key-secret-min-32-chars-change-in-production

# AES-256-GCM Encryption Key — REQUIRED for storing API keys securely
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be a 64-character hex string (32 bytes). Keep this secret and NEVER commit it.
ENCRYPTION_KEY=your_64_char_hex_key_here_generate_with_command_above

# ============================
# STRIPE BILLING (REQUIRED FOR SAAS)
# ============================
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create products in Stripe dashboard)
# Free Plan
STRIPE_PRICE_FREE_MONTHLY=price_free_monthly
STRIPE_PRICE_FREE_YEARLY=price_free_yearly

# Starter Plan ($29/mo)
STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly
STRIPE_PRICE_STARTER_YEARLY=price_starter_yearly

# Professional Plan ($99/mo)
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_professional_monthly
STRIPE_PRICE_PROFESSIONAL_YEARLY=price_professional_yearly

# Business Plan ($299/mo)
STRIPE_PRICE_BUSINESS_MONTHLY=price_business_monthly
STRIPE_PRICE_BUSINESS_YEARLY=price_business_yearly

# Enterprise Plan ($999/mo)
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_enterprise_monthly
STRIPE_PRICE_ENTERPRISE_YEARLY=price_enterprise_yearly

# ============================
# EMAIL (REQUIRED FOR NOTIFICATIONS)
# ============================
# Option 1: SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key

# Option 2: SMTP (Gmail, etc)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com

# ============================
# FILE STORAGE
# ============================
# Option 1: Local Storage
UPLOAD_DIR=./uploads

# Option 2: AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Option 3: Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_ACCESS_KEY_ID=your_access_key
CLOUDFLARE_SECRET_ACCESS_KEY=your_secret_key
CLOUDFLARE_BUCKET=your-bucket-name

# ============================
# CDN (OPTIONAL)
# ============================
CDN_URL=https://cdn.yourdomain.com
CLOUDFLARE_ZONE_ID=your_zone_id
CLOUDFLARE_API_TOKEN=your_api_token

# ============================
# ANALYTICS & MONITORING
# ============================
# Sentry (Error Monitoring) — when set, errors are reported with request context.
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# Prometheus metrics are served at GET /api/v1/metrics (no config needed).

# Mixpanel (User Analytics)
MIXPANEL_TOKEN=your_mixpanel_token

# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# ============================
# THIRD-PARTY INTEGRATIONS
# ============================
# Intercom (Live Chat)
INTERCOM_APP_ID=your_intercom_app_id
INTERCOM_API_KEY=your_intercom_api_key

# Slack (Notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Zapier
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/YOUR/WEBHOOK/

# ============================
# RATE LIMITING
# ============================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================
# CORS
# ============================
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3000

# ============================
# FEATURE FLAGS
# ============================
ENABLE_SIGNUP=true
ENABLE_2FA=false
ENABLE_SSO=false
ENABLE_WHITE_LABEL=false

# ============================
# BACKGROUND WORKERS
# ============================
# Automatic webhook delivery retries with exponential backoff (every minute).
WEBHOOK_RETRY_ENABLED=true

# ============================
# DATABASE MIGRATIONS
# ============================
# Run pending migrations on boot (fail-closed in production).
MIGRATE_ON_BOOT=true

# ============================
# DEVELOPMENT ONLY
# ============================
DEBUG=true
LOG_LEVEL=debug
